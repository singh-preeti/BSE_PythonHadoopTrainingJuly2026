import csv
import pandas as pd
import mysql.connector


# -----------------------------
# EXTRACT
# -----------------------------

def extract_stock_data(file_name):
    records = []

    with open(file_name, newline="") as file:
        reader = csv.DictReader(file)

        for row in reader:
            records.append(row)

    print("Extraction Completed")
    print("Number of records:", len(records))

    return records


# -----------------------------
# TRANSFORMATION
# -----------------------------

def transform(records):
    transformed_records = []

    for stock in records:

        open_price = float(stock["open_price"])

        close_price = float(stock["close_price"])

        volume = int(stock["volume"])

        # Price movement

        price_change = close_price - open_price

        # Return percentage

        return_percentage = (
                                    price_change / open_price
                            ) * 100

        # Volume classification

        if volume > 100000:
            category = "HIGH"

        else:
            category = "NORMAL"

        stock["price_change"] = round(
            price_change, 2
        )

        stock["return_percentage"] = round(
            return_percentage, 2
        )

        stock["volume_category"] = category

        transformed_records.append(stock)

    print("Transformation Completed")

    return transformed_records


# -----------------------------
# MYSQL CONNECTION
# -----------------------------

def get_connection():
    connection = mysql.connector.connect(

        host="localhost",
        user="root",
        password="mysql",
        database="bse_db"

    )

    return connection


# -----------------------------
# LOAD INTO MYSQL
# -----------------------------

def load_transformed_records(records):
    connection = get_connection()

    cursor = connection.cursor()

    # Create table

    cursor.execute("""

    CREATE TABLE IF NOT EXISTS stocks(

        trade_id INT,
        company VARCHAR(100),
        sector VARCHAR(100),
        trade_date DATE,
        open_price FLOAT,
        close_price FLOAT,
        volume BIGINT,
        price_change FLOAT,
        return_percentage FLOAT,
        volume_category VARCHAR(20)

    )

    """)

    insert_query = """

    INSERT INTO stocks VALUES
    (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)

    """

    for stock in records:
        cursor.execute(

            insert_query,

            (

                stock["trade_id"],
                stock["company"],
                stock["sector"],
                stock["trade_date"],
                stock["open_price"],
                stock["close_price"],
                stock["volume"],
                stock["price_change"],
                stock["return_percentage"],
                stock["volume_category"]

            )

        )

    connection.commit()

    cursor.close()

    connection.close()

    print("Load Completed")


# -----------------------------
# READ DATA FROM MYSQL
# -----------------------------

def show_data():
    connection = get_connection()

    cursor = connection.cursor()

    cursor.execute(
        "SELECT * FROM stocks LIMIT 10"
    )

    rows = cursor.fetchall()

    print("\nStock Data After Transformation\n")

    for row in rows:
        print(row)

    cursor.close()

    connection.close()


# -----------------------------
# MAIN ETL PIPELINE
# -----------------------------


if __name__ == "__main__":
    print("ETL Pipeline Started\n")

    # Extract

    records = extract_stock_data(
        "stock_data.csv"
    )

    # Transform

    transformed_records = transform(
        records
    )

    print(transformed_records)

    # Load

    load_transformed_records(
        transformed_records
    )

    # Verify Data

    show_data()

    print("\nETL Pipeline Completed")
